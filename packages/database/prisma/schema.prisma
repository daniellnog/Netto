generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id // UUID from Supabase auth.users
  name      String?
  email     String   @unique
  avatarUrl String?
  currency  String   @default("EUR")
  language  String   @default("en")
  createdAt DateTime @default(now())

  transactions   Transaction[]
  spendingLimits SpendingLimit[]
  accounts       Account[]
  creditCards    CreditCard[]
  categories     Category[]
  bills          Bill[]
  billPayments   BillPayment[]
}

model Account {
  id               String   @id @default(dbgenerated("gen_random_uuid()"))
  userId           String
  name             String
  icon             String   @default("💳")
  balance          Decimal  @default(0) @db.Decimal(12, 2)
  excludeFromTotal Boolean  @default(false)
  createdAt        DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id])
  creditCards  CreditCard[]
  transactions Transaction[]
}

model CreditCard {
  id               String   @id @default(dbgenerated("gen_random_uuid()"))
  userId           String
  name             String
  icon             String   @default("💳")
  creditLimit      Decimal? @db.Decimal(12, 2)
  closingDay       Int
  dueDay           Int
  defaultAccountId String?
  createdAt        DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id])
  defaultAccount Account? @relation(fields: [defaultAccountId], references: [id])
}

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  userId    String
  name      String
  icon      String   @default("📂")
  color     String   @default("#6B7280")
  type      String   // "income" | "expense"
  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@unique([userId, name, type])
}

model Transaction {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  userId      String
  type        String   // "income" | "expense"
  amount      Decimal  @db.Decimal(12, 2)
  currency    String
  description String
  category    String
  categoryId  String?
  accountId   String?
  date        DateTime
  createdAt   DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id])
  Category Category? @relation(fields: [categoryId], references: [id])
  account  Account?  @relation(fields: [accountId], references: [id])
}

model SpendingLimit {
  id       String  @id @default(dbgenerated("gen_random_uuid()"))
  userId   String
  category String
  amount   Decimal @db.Decimal(12, 2)
  currency String

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, category])
}

model Bill {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  userId     String
  name       String
  amount     Decimal  @db.Decimal(12, 2)
  type       String   // "income" | "expense"
  recurrence String   // "once" | "weekly" | "monthly" | "yearly"
  dueDay     Int?     // day of month (1-31) for monthly recurrence
  startDate  DateTime
  category   String
  notes      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id])
  payments BillPayment[]
}

model BillPayment {
  id            String    @id @default(dbgenerated("gen_random_uuid()"))
  billId        String
  userId        String
  amount        Decimal   @db.Decimal(12, 2)
  dueDate       DateTime
  paidAt        DateTime?
  status        String    @default("pending") // "pending" | "paid" | "overdue"
  transactionId String?
  createdAt     DateTime  @default(now())

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}
